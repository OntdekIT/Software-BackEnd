# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Used by docker-compose.yml, docker-compose-dev.yml and docker-compose-prod.yml.

# Database
# Must stay ontdekstation013: spring.flyway.schemas is fixed to that name.
SPRING_DATASOURCE_SCHEME=ontdekstation013
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
# Optional override, defaults to jdbc:mariadb://db:3306/<scheme>
# SPRING_DATASOURCE_URL=

# Mail (dev: local relay, other environments: see docs/email-self-hosting.md)
USE_REAL_MAILSERVER=false
MAILSERVER_RELAY_HOST=smtp
MAILSERVER_RELAY_PORT=587
MAILSERVER_RELAY_USER=
MAILSERVER_RELAY_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=

# First admin account
ROOT_USER_FIRSTNAME=Admin
ROOT_USER_LASTNAME=User
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=change-me

# Frontend (dev compose files)
VITE_BACKEND_API_URL=http://localhost:8082
FRONTEND_HOST=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Required for test, acceptance and production (docker-compose-prod.yml).
# Generate each with: openssl rand -base64 48 (unique per environment)
# JWT_SECRET=
# TRUSTED_IP_PEPPER=
# BACKEND_TAG=latest
# FRONTEND_TAG=latest
